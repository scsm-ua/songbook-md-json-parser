{
  "name": "songbook-md-json-parser",
  "version": "1.0.0",
  "description": "Parse markdown song files to JSON format and back to markdown",
  "main": "index.js",
  "bin": {
    "songbook-build": "./build.js",
    "songbook-parse-songs": "./parse-songs.js",
    "songbook-parse-contents": "./parse-contents.js",
    "songbook-parse-index": "./parse-index.js",
    "songbook-validate": "./validate.js"
  },
  "exports": {
    ".": {
      "require": "./index.js",
      "default": "./index.js"
    }
  },
  "scripts": {
    "build": "node build.js",
    "parse:songs": "node parse-songs.js",
    "parse:contents": "node parse-contents.js",
    "parse:index": "node parse-index.js",
    "validate": "node validate.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "songbook",
    "markdown",
    "json",
    "parser"
  ],
  "license": "ISC",
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "js-yaml": "^4.1.0"
  }
}
