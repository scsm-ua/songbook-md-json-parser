{
  "name": "songbook-md-json-parser",
  "version": "1.0.0",
  "description": "Parse markdown song files to JSON format and back to markdown",
  "main": "index.js",
  "bin": {
    "songbook-build": "./build.js",
    "songbook-parse-songs": "./parse-songs.js",
    "songbook-parse-pages": "./parse-pages.js",
    "songbook-parse-contents": "./parse-contents.js",
    "songbook-parse-index": "./parse-index.js",
    "songbook-validate": "./validate.js",
    "songbook-list-authors": "./list-authors.js",
    "songbook-test-authors": "./test-authors.sh"
  },
  "exports": {
    ".": {
      "require": "./index.js",
      "default": "./index.js"
    }
  },
  "scripts": {
    "build:schema": "node schema/build-schema.js",
    "validate:songs": "node validate.js ./test-fixtures/valid-songs --type song",
    "validate:songs:invalid": "node validate.js ./test-fixtures/invalid-songs --type song",
    "validate:pages": "node validate.js ./test-fixtures/valid-pages --type page",
    "validate:pages:invalid": "node validate.js ./test-fixtures/invalid-pages --type page",
    "test": "node test-exit-codes.js"
  },
  "keywords": [
    "songbook",
    "markdown",
    "json",
    "parser"
  ],
  "license": "ISC",
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "js-yaml": "^4.1.0"
  }
}
